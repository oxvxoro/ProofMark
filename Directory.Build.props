<Project>

  <Import Project="$(MSBuildThisFileDirectory)Version.props" />

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Build" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Update="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Update="Microsoft.Build.Locator" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
