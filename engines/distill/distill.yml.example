version: 1

workspace:
  solution: Distill.sln
  runDir: .distill/runs

testing:
  platform: auto

redaction:
  patterns:
    - "MyCompanySecret=.*"

reliability:
  minConfidence: 0.5

profiles:
  quick:
    checks: [build, unit]

  full:
    checks: [build, unit, format]

checks:
  build:
    kind: build
    command: dotnet build Distill.sln --no-restore
    source: msbuild-binlog
    timeout: 300
    stopOnFailure: true

  unit:
    kind: test
    command: dotnet test tests/Distill.Tests/Distill.Tests.csproj --no-build
    source: auto
    dependsOn: [build]
    timeout: 600
    stopOnFailure: true

  format:
    kind: format
    command: dotnet format Distill.sln --verify-no-changes --no-restore
    source: generic
    dependsOn: [build]
    timeout: 300
    stopOnFailure: true
