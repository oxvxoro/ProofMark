{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "DemoAnalyzer",
          "rules": [
            {
              "id": "DEMO001",
              "shortDescription": {
                "text": "Avoid demo warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "DEMO001",
          "level": "warning",
          "message": {
            "text": "Avoid demo warning; token=should-be-redacted"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/Demo.cs"
                },
                "region": {
                  "startLine": 12,
                  "startColumn": 5
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
